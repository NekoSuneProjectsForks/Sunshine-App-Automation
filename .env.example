# Steam library VDF file location
STEAM_LIBRARY_VDF_PATH="YOUR_STEAM_LIBRARY_VDF_PATH"

# Sunshine apps.json location
SUNSHINE_APPS_JSON_PATH="YOUR_SUNSHINE_APPS_JSON_PATH"

# Sunshine grids folder
SUNSHINE_GRIDS_FOLDER="YOUR_SUNSHINE_GRIDS_FOLDER_PATH"

# Optional SteamGridDB API key (get from https://www.steamgriddb.com/profile/preferences)
STEAMGRIDDB_API_KEY=

# Steam executable path
STEAM_EXE_PATH="YOUR_STEAM_EXE_PATH"

# Sunshine executable path
SUNSHINE_EXE_PATH="YOUR_SUNSHINE_EXE_PATH"
